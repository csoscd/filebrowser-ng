# Required
SMB_SERVER=192.168.1.100

# Optional
SMB_DOMAIN=
SESSION_LIFETIME=3600
SESSION_NAME=filebrowser_sess
LOG_PATH=/var/www/log/filebrowser-ng.log
LOG_LEVEL=info
LOG_MAX_DAYS=30
I18N_LANGUAGE=en
DB_PATH=/var/www/data/filebrowser.sqlite
UPLOAD_CHUNK_SIZE=10485760

# OIDC (optional – leave empty / false to use classic SMB login)
# Set OIDC_ENABLED=true to activate. All other OIDC_ vars are then required.
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Full OpenID Configuration URL or issuer URL (/.well-known/openid-configuration appended automatically)
OIDC_DISCOVERY_URL=
# Must match the redirect URI registered at the OIDC provider
OIDC_REDIRECT_URI=https://files.example.com/auth/oidc/callback
# Custom claim in the ID Token carrying the per-user SMB encryption key
OIDC_SMB_KEY_CLAIM=smb_key
# Claim to use as SMB username (empty = preferred_username → sub)
OIDC_USERNAME_CLAIM=
# Set to false when the OIDC provider uses a private/self-signed certificate
OIDC_VERIFY_SSL=true
