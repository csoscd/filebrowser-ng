{
    "name": "cs/filebrowser-ng",
    "description": "Web-based file manager for SMB/Samba shares",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Christian Schulz",
            "email": "technik@meinetechnikwelt.rocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "icewind/smb": "^3.8",
        "hassankhan/config": "^2.1",
        "monolog/monolog": "^3.6",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "FilebrowserNg\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
