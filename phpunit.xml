<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <!-- hassankhan/config v2.1 is not fully PHP 8.4 compatible (implicit nullable types).
             Suppress E_DEPRECATED (8192) at the ini level so vendor deprecations do not
             produce exit-code 2 in CI. Our own source code triggers no E_DEPRECATED.
             24575 = E_ALL (32767) & ~E_DEPRECATED (8192) -->
        <ini name="error_reporting" value="24575"/>
    </php>
</phpunit>
